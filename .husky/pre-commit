echo "[Quality Gate] Dang kiem tra chat luong ma nguon truoc khi commit..."

# 1. Kiem tra dinh dang ten nhanh
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)
EXEMPT_BRANCHES="^(main|master|develop|staging|production)$"

if [[ ! $BRANCH_NAME =~ $EXEMPT_BRANCHES ]]; then
  BRANCH_PATTERN="^dev_[a-z0-9]+_[a-z0-9_]+$"
  if [[ ! $BRANCH_NAME =~ $BRANCH_PATTERN ]]; then
    echo "[Error] Ten nhanh '$BRANCH_NAME' khong hop le!"
    echo "Quy chuan ten nhanh: dev_{developer_name}_{feature_description} (VD: dev_phong_update_view_board)"
    exit 1
  fi
fi

# 2. Kiem tra dinh dang code voi Prettier
echo "[Prettier] Dang kiem tra dinh dang code..."
npx prettier --check . || {
  echo "[Error] Code chua duoc format theo chuan Prettier. Chai 'npm run format' de tu dong sua!"
  exit 1
}

# 3. Chay Linter voi Oxlint
echo "[Oxlint] Dang quet linter va ngan chan kieu any..."
npx oxlint --deny-warnings || exit 1

# 4. Kiem tra kieu TypeScript & Build
echo "[TypeScript & Build] Dang typecheck va bien dich..."
npm run build || exit 1

echo "[Quality Gate] Tat ca kiem tra thanh cong! Cho phép commit."
