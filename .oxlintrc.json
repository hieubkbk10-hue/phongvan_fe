{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "react-hooks", "typescript"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/only-export-components": "off",
    "no-unused-vars": "error",
    "react-hooks/exhaustive-deps": "warn"
  }
}
